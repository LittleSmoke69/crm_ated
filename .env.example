# Copie para .env, preencha e nunca commite o .env.
# Cap do Sucesso / stack com Evolution (sem RabbitMQ): use APP_SCOPE=full.

# Supabase self-hosted
NEXT_PUBLIC_SUPABASE_URL=https://supabase.seudominio.com
NEXT_PUBLIC_SUPABASE_ANON_KEY=sua_chave_anon_publica
SUPABASE_SERVICE_ROLE_KEY=sua_chave_service_role_apenas_server_side

# URL publica do CRM (apex ou crm.seudominio.com)
SITE_URL=https://crm.seudominio.com
URL=https://crm.seudominio.com
NEXT_PUBLIC_SITE_URL=https://crm.seudominio.com
NEXT_PUBLIC_APP_URL=https://crm.seudominio.com
NEXT_PUBLIC_WEBHOOK_BASE_URL=https://crm.seudominio.com

# Gere cada valor com: openssl rand -hex 48
SESSION_SECRET=
ENCRYPTION_PEPPER=

# Escopo: modelagem = CRM leve sem Evolution; full = Evolution + campanhas no código
NEXT_PUBLIC_ZAPLOTO_APP_SCOPE=full
ZAPLOTO_APP_SCOPE=full
NEXT_PUBLIC_ZAPLOTO_DISABLE_EVOLUTION_STACK=false
ZAPLOTO_DISABLE_EVOLUTION_STACK=false

# Evolution API (WhatsApp)
EVOLUTION_BASE_URL=https://evolution.seudominio.com
EVOLUTION_API_KEY=
# Webhook Evolution não exige token no env — rotas usam rate limit por IP.
EVOLUTION_WEBHOOK_SKIP_MASTER=false
# Dev only (nunca em produção):
# EVOLUTION_WEBHOOK_ALLOW_LOCALHOST=true
# Sem RABBITMQ_URL o endpoint /api/webhooks/evolution/prod processa em sync (stack leve).
# RABBITMQ_URL=amqp://user:pass@rabbitmq:5672

# Integracoes opcionais das telas mantidas
CRM_API_KEY=
GEMINI_API_KEY=
VTURB_ANALYTICS_TOKEN=
VTURB_ANALYTICS_VERSION=v1
LOG_META_ADS_HIERARCHY=0

# Chat WhatsApp Oficial: valida X-Hub-Signature-256.
WHATSAPP_OFFICIAL_APP_SECRET=

# Cron interno (/api/internal/cron/*)
CRON_SECRET=

# Usernames (ou e-mails) elevados a super_admin via env. Separados por vírgula; @ opcional.
# Ex.: SUPER_ADMIN_USERNAMES=carlinhosbig
SUPER_ADMIN_USERNAMES=

# SMTP / relay
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Nome <remetente@seudominio.com.br>"
NEWSLETTER_DELAY_BETWEEN_SENDS_MS=200
EMAIL_TRACKING_SECRET=
# EMAIL_RELAY_URL=https://mail-relay.seudominio.com
# EMAIL_RELAY_SECRET=mesmo_secret_do_container_email-relay
