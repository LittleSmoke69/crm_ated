# Stack leve "modelagem". Copie para .env, preencha e nunca commite o .env.

# Supabase self-hosted
NEXT_PUBLIC_SUPABASE_URL=https://supabase.seudominio.com
NEXT_PUBLIC_SUPABASE_ANON_KEY=sua_chave_anon_publica
SUPABASE_SERVICE_ROLE_KEY=sua_chave_service_role_apenas_server_side

# URL publica do CRM
SITE_URL=https://crm.seudominio.com
URL=https://crm.seudominio.com
NEXT_PUBLIC_SITE_URL=https://crm.seudominio.com

# Gere cada valor com: openssl rand -hex 48
SESSION_SECRET=
ENCRYPTION_PEPPER=

# Escopo leve: somente modulos provisionados pela modelagem/sidebar.
NEXT_PUBLIC_ZAPLOTO_APP_SCOPE=modelagem
ZAPLOTO_APP_SCOPE=modelagem
NEXT_PUBLIC_ZAPLOTO_DISABLE_EVOLUTION_STACK=true
ZAPLOTO_DISABLE_EVOLUTION_STACK=true

# Integracoes opcionais das telas mantidas
CRM_API_KEY=
GEMINI_API_KEY=
VTURB_ANALYTICS_TOKEN=
VTURB_ANALYTICS_VERSION=v1
LOG_META_ADS_HIERARCHY=0

# Chat WhatsApp Oficial: valida X-Hub-Signature-256.
# Se vazio, a aplicacao usa o webhook_secret salvo na configuracao do tenant.
WHATSAPP_OFFICIAL_APP_SECRET=

# Cron interno (/api/internal/cron/*) - mesmo segredo usado pelos demais crons do projeto
CRON_SECRET=

# Disparo de e-mail (SMTP): fallback usado quando nao ha conta cadastrada em Admin > E-mails.
# Com contas cadastradas no admin, estas variaveis sao opcionais.
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Nome <remetente@seudominio.com.br>"
# Delay (ms) entre envios de uma campanha em massa - protege a reputacao do SMTP
NEWSLETTER_DELAY_BETWEEN_SENDS_MS=200
# Chave HMAC dos links de clique rastreados; sem isso usa SUPABASE_SERVICE_ROLE_KEY como fallback
EMAIL_TRACKING_SECRET=

# Relay HTTPS (Contabo) — obrigatorio na SuperBitHost (SMTP outbound bloqueado).
# Sem essas vars, o mailer tenta SMTP direto (ok no Mac/dev).
# EMAIL_RELAY_URL=https://mail-relay.seudominio.com
# EMAIL_RELAY_SECRET=mesmo_secret_do_container_email-relay

